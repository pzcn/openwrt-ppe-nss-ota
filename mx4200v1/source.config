# MX4200 v1 ONLY: IPQ8174, 512 MiB RAM, NAND/UBI, 6 MiB kernel partition.
# ImmortalWrt master + Julius PPE (wired) / NSS (ath11k Wi-Fi).
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v1=y
# CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_linksys_mx4200v2 is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
CONFIG_SDK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# The MX4200 kernel FIT must fit in exactly 6144 KiB.
# Julius' 6m-kernel group needs REGULAR rather than STRONG here.
# CONFIG_KERNEL_CC_STACKPROTECTOR_STRONG is not set
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y

# Modern PPE/EDMA wired offload and NSS Wi-Fi. No ECM/qca-nss-dp stack.
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_ppe-help=y
CONFIG_PACKAGE_qca-ppe-qos=y
CONFIG_PACKAGE_luci-app-qca-ppe-qos=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-ets=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_dcb=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_KERNEL_DCB=y

CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
