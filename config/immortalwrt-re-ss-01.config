# ImmortalWrt master + JuliusBairaktaris PPE/NSS + custom RE-SS-01 overlay
# Single device, sysupgrade image only; the modified 1 GiB router still
# uses the compatible ipq60xx 512 MiB ath11k/NSS memory profile.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# TARGET_DEVICE_* options require multi-profile mode in OpenWrt Kconfig.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# Bundle kernel ABI-matched packages for reproducible incremental image builds.
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
# Enable developer build options so Kconfig retains CONFIG_CCACHE=y.
CONFIG_DEVEL=y
# Cache compilation results only; never share compiled kernel ABI or patch trees.
CONFIG_CCACHE=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y

# Mainline qca_edma/qca_ppe offloads traffic in hardware. No vendor NSS/ECM.
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_qca-ppe-qos=y
CONFIG_PACKAGE_luci-app-qca-ppe-qos=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-ets=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_PACKAGE_dcb=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_KERNEL_DCB=y

# Keep package versions available for user-space restoration.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-sing-box=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_uclient-fetch=y

# Leave rootfs_data management to upstream; retain ext4 for the separate p27.
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_block-mount=y

# A full source build supplies the kernel-matched packages.
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_ppe-help=y
