# RE-SS-01 Hybrid P2: compile only local kernel/DTB, NSS and necessary modules.
# Official snapshot userspace APKs are imported later in P3, not built here.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# P2 is genuinely kernel-only. SDK / standalone IB are assembled in P3
# after the kernel, ABI and local kmods have been validated.
# CONFIG_IB is not set
# CONFIG_IB_STANDALONE is not set
# CONFIG_SDK is not set
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
# Required by the official userspace APK dependency closure (audit #43433821208).
# Keep this explicit instead of enabling CONFIG_ALL_KMODS.
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-sched-flower=y
CONFIG_PACKAGE_kmod-sched-prio=y
CONFIG_PACKAGE_kmod-sched-ets=y
CONFIG_PACKAGE_kmod-sched-mqprio=y
CONFIG_PACKAGE_kmod-sched-act-pedit=y
CONFIG_PACKAGE_kmod-sched-act-police=y
CONFIG_KERNEL_DCB=y
CONFIG_PACKAGE_qca-ppe-qos=y
CONFIG_PACKAGE_ppe-help=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# Intentionally no sing-box, tailscale, ddns-go, LuCI, or generic full feed build.
