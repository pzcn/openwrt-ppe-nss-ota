#!/bin/sh
# This changes only LuCI appearance and language, not credentials or Wi-Fi.
if [ -f /etc/config/luci ] && [ -d /www/luci-static/aurora ]; then
    uci -q set luci.main.mediaurlbase='/luci-static/aurora'
fi
if [ -f /etc/config/luci ]; then
    uci -q set luci.main.lang='zh_cn'
    uci -q commit luci
fi
# OTA now targets this repo only. Preserve the user's explicit choice on
# sysupgrade; initialize disabled ONLY if the setting did not exist.
if [ -f /etc/config/ppe-update ]; then
    auto="$(uci -q get ppe-update.main.auto 2>/dev/null || true)"
    if [ -z "$auto" ]; then
        uci -q set ppe-update.main.auto='0'
        uci -q commit ppe-update
    fi
fi
exit 0
