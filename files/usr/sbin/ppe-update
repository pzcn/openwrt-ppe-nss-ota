#!/bin/sh
# RE-SS-01 firmware update helper.
# Derived from JuliusBairaktaris/Qualcommax_NSS_Builder ppe-update, GPL-2.0.
#
# Interfaces remain compatible with the upstream LuCI plugin:
#   ppe-update status | check | update | start | auto | restore
#
# Uses the configured release channel with device, version and image checks.
#
# Automatic updates follow the configured schedule in LuCI.
# Both manual and automatic upgrades preserve the extra package list for
# restoration after reboot. Device identity, SHA256 and sysupgrade -T are checked.

[ -r "${PPE_RELEASE:=/etc/ppe-release}" ] && . "$PPE_RELEASE"
[ -r "${PZCN_RELEASE:=/etc/pzcn-ota-release}" ] && . "$PZCN_RELEASE"

STATE=${PPE_STATE:-/etc/ppe-update}
WORK=${PPE_WORK:-/tmp/ppe-update}
APK_WORLD=${PPE_APK_WORLD:-/etc/apk/world}
APK_ROM_WORLD=${PPE_APK_ROM_WORLD:-/rom/etc/apk/world}
RESTORE_HEADER='# ppe-update-extras-v2'
BOARD=$(cat /tmp/sysinfo/board_name 2>/dev/null)
RELEASE_REPO='pzcn/openwrt-ppe-nss-ota'
RELEASE_API='https://api.github.com/repos/pzcn/openwrt-ppe-nss-ota/releases/latest'
RELEASE_ASSETS='https://github.com/pzcn/openwrt-ppe-nss-ota/releases/download'
RELEASE_CHANNEL='re-ss-01-custom'
EXPECTED_BOARD='jdcloud,re-ss-01'
EXPECTED_PROFILE='jdcloud_re-ss-01'
EXPECTED_GROUP='ipq60xx-512m'
EXPECTED_IMAGE='openwrt-pzcn-qualcommax-ipq60xx-jdcloud_re-ss-01-squashfs-sysupgrade.bin'
EXPECTED_MANIFEST='openwrt-pzcn-qualcommax-ipq60xx-jdcloud_re-ss-01.manifest'

log() { logger -t ppe-update "$*"; echo "$*" >&2; }
# A small atomic status snapshot for the active OTA job; the image is still
# installed exclusively by sysupgrade.
progress_set() {
	[ "${OTA_PROGRESS_ACTIVE:-0}" = 1 ] || return 0
	local stage="$1" message="${2:-}" total="${3:-0}" started="${OTA_DOWNLOAD_STARTED:-0}" now tmp
	case "$total" in ''|*[!0-9]*) total=0 ;; esac
	case "$started" in ''|*[!0-9]*) started=0 ;; esac
	mkdir -p "$WORK"
	now=$(date +%s)
	tmp="$WORK/progress.json.$"
	jq -nc --arg stage "$stage" --arg message "$message" \
		--argjson total "$total" --argjson started "$started" --argjson updated "$now" \
		'{stage:$stage, message:$message, total:$total, started:$started, updated:$updated}' >"$tmp" &&
		mv -f "$tmp" "$WORK/progress.json"
}
die() {
	[ "${OTA_PROGRESS_ACTIVE:-0}" != 1 ] || progress_set failed "$*" || :
	log "$*"
	exit 2
}

# GitHub Releases may send 302 headers with >4 KiB CSP lines. The
# uclient-fetch HTTP parser can stall on those headers even when TLS and TCP
# are working. Use curl first; keep uclient-fetch as a fallback when curl is
# missing or cannot download the file. Keep OTA validation unchanged.
# Prefix-style proxies accept BASE/https://github.com/owner/repo/...
# Status requests prefer the official API (mirrors may reject api.github.com).
github_proxy_base() {
	local mode base
	mode="$(uci -q get ppe-update.main.github_proxy 2>/dev/null)" || mode='direct'
	case "$mode" in
	''|direct) return 1 ;;
	ghfast) base='https://ghfast.top' ;;
	ghproxy) base='https://ghproxy.net' ;;
	gh_proxy) base='https://gh-proxy.com' ;;
	custom) base="$(uci -q get ppe-update.main.github_proxy_url 2>/dev/null)" || base='' ;;
	*) log 'invalid GitHub proxy selection'; return 2 ;;
	esac
	base="${base%/}"
	# Do not let grep validate just one line of a multiline UCI value.
	case "$base" in *[[:space:]]*) log 'invalid GitHub proxy URL'; return 2 ;; esac
	[ "${#base}" -le 200 ] &&
		printf '%s\n' "$base" |
			grep -Eq '^https://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$' || {
		log 'invalid GitHub proxy URL (HTTPS base only)'
		return 2
	}
	printf '%s\n' "$base"
}

fetch_once() {
	local url="$1" dest="$2" max_time="${3:-60}"
	rm -f "$dest"
	if command -v curl >/dev/null 2>&1 &&
		curl -fLsS --retry 2 --connect-timeout 10 --max-time "$max_time" \
			-o "$dest" "$url" 2>>"$WORK/fetch-error.log" &&
		[ -s "$dest" ]; then
		return 0
	fi
	rm -f "$dest"
	if uclient-fetch -q -T 30 -O "$dest" "$url" 2>>"$WORK/fetch-error.log" &&
		[ -s "$dest" ]; then
		return 0
	fi
	rm -f "$dest"
	return 1
}

fetch() {
	local url="$1" dest="$2" max_time="${3:-60}" base='' result=0
	base="$(github_proxy_base)" || result=$?
	[ "$result" -ne 2 ] || return 1
	case "$url" in
	https://api.github.com/*)
		fetch_once "$url" "$dest" "$max_time" && return 0
		if [ -n "$base" ]; then
			fetch_once "$base/$url" "$dest" "$max_time" && return 0
		fi
		;;
	https://github.com/*)
		if [ -n "$base" ]; then
			fetch_once "$base/$url" "$dest" "$max_time" && return 0
		fi
		fetch_once "$url" "$dest" "$max_time" && return 0
		;;
	*)
		fetch_once "$url" "$dest" "$max_time" && return 0
		;;
	esac
	return 1
}

valid_integer() {
	case "$1" in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac
}

valid_hash() {
	[ "${#1}" -eq 64 ] || return 1
	case "$1" in *[!0123456789abcdef]*) return 1 ;; esac
}

# The upstream /etc/ppe-release is left intact for matching kernel APK feeds.
# Our independent /etc/pzcn-ota-release identifies the complete customized
# image and is generated before the ROM image is assembled.
# Query the selected latest *public* release, not the upstream PPE+NSS site.
# Every candidate must ship an ota.json that matches our device/channel.
index() {
	[ -n "$OTA_TAG" ] && valid_integer "$OTA_BUILD" &&
		[ "$OTA_CHANNEL" = "$RELEASE_CHANNEL" ] ||
		die "missing local firmware update identity"
	[ "$BOARD" = "$EXPECTED_BOARD" ] &&
		[ "$GROUP" = "$EXPECTED_GROUP" ] ||
		die "board or PPE group mismatch: refusing OTA"
	mkdir -p "$WORK"
	: >"$WORK/fetch-error.log"
	fetch "$RELEASE_API" "$WORK/github.json" || die "cannot reach custom GitHub Releases API"
	LATEST=$(jsonfilter -i "$WORK/github.json" -e '@.tag_name')
	case "$LATEST" in
	ota-ppe-nss-*) ;;
	*) die "latest firmware release is not on the expected channel" ;;
	esac
	case "$LATEST" in *[!a-zA-Z0-9._-]*) die "unsafe release tag" ;; esac
	# We do not trust arbitrary names or paths from a release.
	fetch "$RELEASE_ASSETS/$LATEST/ota.json" "$WORK/ota.json" ||
		die "failed to fetch latest OTA metadata asset from GitHub"
	jq -e 'type == "object"' "$WORK/ota.json" >/dev/null 2>&1 ||
		die "invalid OTA metadata JSON"
	meta() { jsonfilter -i "$WORK/ota.json" -e "@.$1"; }
	[ "$(meta schema)" = 1 ] &&
		[ "$(meta channel)" = "$RELEASE_CHANNEL" ] &&
		[ "$(meta repository)" = "$RELEASE_REPO" ] &&
		[ "$(meta tag)" = "$LATEST" ] &&
		[ "$(meta board)" = "$EXPECTED_BOARD" ] &&
		[ "$(meta profile)" = "$EXPECTED_PROFILE" ] &&
		[ "$(meta group)" = "$EXPECTED_GROUP" ] ||
		die "custom OTA metadata does not match this device"
	[ "$(meta image)" = "$EXPECTED_IMAGE" ] &&
		[ "$(meta manifest)" = "$EXPECTED_MANIFEST" ] ||
		die "unexpected firmware or manifest asset in custom release"
	LATEST_BUILD=$(meta build)
	LATEST_TIME=$(meta epoch)
	LATEST_UPSTREAM=$(meta upstream_tag)
	SHA256=$(meta image_sha256)
	MANIFEST_SHA256=$(meta manifest_sha256)
	SIZE=$(meta image_size)
	valid_integer "$LATEST_BUILD" && valid_integer "$LATEST_TIME" &&
		valid_integer "$SIZE" && valid_hash "$SHA256" &&
		valid_hash "$MANIFEST_SHA256" ||
		die "invalid build, timestamp, size or checksum"
	[ "$LATEST_BUILD" -gt 0 ] && [ "$SIZE" -gt 1000000 ] &&
		[ "$LATEST_TIME" -gt 0 ] ||
		die "invalid OTA release metadata values"
	case "$LATEST_UPSTREAM" in
	ppe-nss-*) ;;
	*) die "invalid upstream PPE+NSS tag" ;;
	esac
	case "$LATEST_UPSTREAM" in *[!a-zA-Z0-9._-]*) die "unsafe upstream release tag" ;; esac
	IMAGE="$EXPECTED_IMAGE"
	MANIFEST="$EXPECTED_MANIFEST"
	NEWGROUP="$EXPECTED_GROUP"
}

# The current build number is embedded in ROM. No string tag comparisons:
# an older release promoted as "latest" must never downgrade the device.
newer() {
	[ "$LATEST" != "$OTA_TAG" ] && [ "$LATEST_BUILD" -gt "$OTA_BUILD" ]
}

# Save only package names, never release-controlled shell code.
lookup() {
	index
	[ -z "$1" ] || [ "$1" = "$LATEST" ] ||
		die "requested release is not the latest verified custom release"
	[ "$LATEST" != "$OTA_TAG" ] || return 0
	fetch "$RELEASE_ASSETS/$LATEST/$MANIFEST" "$WORK/manifest.full" ||
		die "custom release package manifest is missing"
	[ "$(sha256sum "$WORK/manifest.full" | cut -d' ' -f1)" = "$MANIFEST_SHA256" ] ||
		die "package manifest checksum mismatch"
	awk 'NF >= 2 { print $1 }' "$WORK/manifest.full" >"$WORK/manifest"
	[ -s "$WORK/manifest" ] || die "empty package manifest"
}


# apk world contains requested top-level packages, including every default
# selection baked into the *old* image. Compare with the old ROM world first:
# omitting this subtraction reinstalls removed stock packages after every OTA.
# Keep explicit negative world constraints; never infer removals merely because
# a stock package is absent from the writable world.
apk_world_names() {
	[ -s "$1" ] || return 1
	awk -v negative="${2:-0}" '
		{
			name=$0
			if (negative == 1) {
				if (substr(name, 1, 1) != "!") next
				name=substr(name, 2)
			} else if (substr(name, 1, 1) == "!") next
			sub(/[@<>=~].*$/, "", name)
			if (name ~ /^[A-Za-z0-9][A-Za-z0-9+._-]*$/) print name
		}
	' "$1" | sort -u
}

extras() {
	[ -s "$WORK/manifest" ] || return 1
	apk_world_names "$APK_WORLD" >"$WORK/world" || return 1
	apk_world_names "$APK_ROM_WORLD" >"$WORK/rom-world" || return 1
	apk_world_names "$APK_WORLD" 1 >"$WORK/world-excluded" || return 1
	apk_world_names "$APK_ROM_WORLD" 1 >"$WORK/rom-excluded" || return 1
	{
		# Only user-added top-level packages absent from the new image. Never
		# reinstall old kernel modules or ABI-stamped system libraries by name.
		grep -vxF -f "$WORK/rom-world" "$WORK/world" |
			grep -vxF -f "$WORK/manifest" |
			awk '!/^kmod-/ && !/^lib[A-Za-z0-9+._-]*[0-9]{8}$/'
		grep -vxF -f "$WORK/rom-excluded" "$WORK/world-excluded" |
			sed 's/^/!/'
	} | sort -u
}

# Versions before v2 saved a new-manifest difference, including old ROM
# dependencies. The old ROM baseline is lost after sysupgrade, so it cannot
# reliably be reconstructed. Archive such a queue rather than bulk-installing
# untrusted leftovers; retain all names so an administrator can review them.
archive_legacy_queue() {
	[ -s "$STATE/packages" ] || return 0
	[ "$(sed -n '1p' "$STATE/packages")" != "$RESTORE_HEADER" ] || return 0
	mkdir -p "$STATE" || return 1
	local tmp="$STATE/packages.legacy.$$"
	{
		[ ! -s "$STATE/packages.legacy" ] || cat "$STATE/packages.legacy"
		cat "$STATE/packages"
	} | sed '/^[[:space:]]*$/d' | sort -u >"$tmp" || return 1
	mv -f "$tmp" "$STATE/packages.legacy" || return 1
	rm -f "$STATE/packages"
	log "旧版软件包恢复队列已归档到 $STATE/packages.legacy，停止自动重装；请按需手动恢复插件"
}

cmd_status() {
	auto=$(uci -q get ppe-update.main.auto 2>/dev/null)
	[ -n "$auto" ] || auto=0
	pending=""
	if [ -r "$STATE/packages" ] &&
	   [ "$(sed -n '1p' "$STATE/packages")" = "$RESTORE_HEADER" ]; then
		pending=$(sed '1d' "$STATE/packages" | tr '\n' ' ')
	fi
	legacy_count=0
	if [ -s "$STATE/packages.legacy" ]; then
		legacy_count=$(awk 'NF {n++} END {print n+0}' "$STATE/packages.legacy")
	fi
	mkdir -p "$WORK"
	# Preserve the real reason for failure. A missing channel release is not
	# a router networking failure; neither are invalid metadata or API errors.
	if status_json=$(
		lookup ""
		# Discovery must not depend on APK mirror health or compatibility checks.
		if newer; then
			avail=true
		else
			avail=false
		fi
		printf '{"board":"%s","current":"%s","build":%s,"group":"%s","latest":"%s","latest_time":%s,"update":%s,"image":"%s","size":%s,"extras":"%s","missing":"","checked":false,"pending":"%s","legacy_count":%s,"auto":"%s","source":"%s"}\n' \
			"$BOARD" "$OTA_TAG" "$OTA_BUILD" "$GROUP" "$LATEST" "$LATEST_TIME" "$avail" "$IMAGE" "$SIZE" \
			"$(extras | tr '\n' ' ')" "$pending" "$legacy_count" "$auto" "GitHub Releases"
	) 2>"$WORK/status-error.log"; then
		printf '%s\n' "$status_json"
		return 0
	fi

	# Error messages below are fixed strings so that the RPC reply stays
	# valid JSON even when GitHub returns unexpected content.
	if grep -Fq 'no ImmortalWrt firmware release' "$WORK/status-error.log"; then
		reason='暂无可用固件'
	elif grep -Fq 'cannot reach custom GitHub Releases API' "$WORK/status-error.log"; then
		reason='GitHub API 连接失败'
	elif grep -Eq 'invalid GitHub Releases API response|failed to parse GitHub firmware release index' "$WORK/status-error.log"; then
		reason='GitHub API 响应异常'
	elif grep -Fq 'failed to fetch latest OTA metadata asset from GitHub' "$WORK/status-error.log"; then
		reason='更新信息下载失败'
	elif grep -Fq 'custom release package manifest is missing' "$WORK/status-error.log"; then
		reason='软件包清单下载失败'
	elif grep -Eq 'metadata|checksum|not on the expected channel|unexpected firmware|missing local firmware|board or PPE group mismatch' "$WORK/status-error.log"; then
		reason='固件信息或设备不匹配'
	else
		reason='检查失败，请运行 ppe-update check'
	fi
	printf '{"board":"%s","current":"%s","group":"%s","error":"%s","pending":"%s","legacy_count":%s,"auto":"%s","source":"%s"}\n' \
		"$BOARD" "$OTA_TAG" "$GROUP" "$reason" "$pending" "$legacy_count" "$auto" "GitHub Releases"
}

# Read-only progress endpoint: measure in-flight bytes using a cheap stat,
# while the front end computes the recent transfer speed from successive polls.
cmd_progress() {
	local downloaded=0
	if [ -r "$WORK/progress.json" ]; then
		if [ -f "$WORK/$EXPECTED_IMAGE" ]; then
			downloaded=$(stat -c %s "$WORK/$EXPECTED_IMAGE" 2>/dev/null) || downloaded=0
		fi
		valid_integer "$downloaded" || downloaded=0
		jq -c --argjson downloaded "$downloaded" \
			'. + {downloaded:$downloaded}' "$WORK/progress.json" 2>/dev/null &&
			return 0
	fi
	printf '{"stage":"idle","message":"","total":0,"downloaded":0,"started":0}\n'
}

cmd_check() {
	lookup ""
	if newer; then
		echo "firmware update available: $OTA_TAG -> $LATEST"
		echo "The firmware image will be verified and extra packages restored after reboot."
		return 0
	fi
	echo "firmware is up to date: $OTA_TAG"
	return 1
}

cmd_update() {
	[ "$2" != "-f" ] || die "sysupgrade -F is not supported"
	policy="${3:-manual}"
	case "$policy" in manual | auto) ;; *) die "unknown OTA policy" ;; esac
	lookup "$1"
	newer || { echo "up to date: $OTA_TAG"; return 1; }

	# Migrate lists created by the previous (overinclusive) algorithm before
	# computing the next upgrade's explicit user package selection.
	archive_legacy_queue || die "unable to archive legacy package restore queue"
	# The ROM baseline is mandatory to distinguish user additions from old
	# stock packages. If unavailable, skip automatic package restoration.
	if ! extras >"$WORK/extras"; then
		: >"$WORK/extras"
		log "无法比对当前和出厂 apk world；本次升级跳过自动恢复软件包"
	fi
	if [ -s "$WORK/extras" ]; then
		log "升级后将尝试恢复额外软件包"
	fi

	# Check actual free download space, not an arbitrary 3x RAM requirement.
	need_kb=$((SIZE / 1024 + 8192))
	avail_kb=$(df -Pk "$WORK" 2>/dev/null | awk 'NR == 2 {print $4}')
	if valid_integer "$avail_kb" && [ "$avail_kb" -gt 0 ] &&
	   [ "$avail_kb" -lt "$need_kb" ]; then
		die "not enough free space: need ${need_kb}K, have ${avail_kb}K"
	fi

	OTA_DOWNLOAD_STARTED=$(date +%s)
	progress_set downloading "正在下载固件：$LATEST" "$SIZE"
	log "正在下载固件：$LATEST"
	# Larger assets need longer timeouts than the small status/API requests.
	if ! fetch "$RELEASE_ASSETS/$LATEST/$IMAGE" "$WORK/$IMAGE" 900; then
		[ ! -s "$WORK/fetch-error.log" ] ||
			log "下载错误详情：$(tail -n 8 "$WORK/fetch-error.log" | tr '\n' ' ')"
		die "download failed"
	fi
	progress_set verifying "下载完成，正在校验 SHA256 和固件兼容性" "$SIZE"
	[ "$(sha256sum "$WORK/$IMAGE" | cut -d' ' -f1)" = "$SHA256" ] ||
		{ rm -f "$WORK/$IMAGE"; die "image SHA256 mismatch"; }
	sysupgrade -T "$WORK/$IMAGE" >"$WORK/validation.log" 2>&1 ||
		{
			[ ! -s "$WORK/validation.log" ] ||
				log "固件检查详情：$(tail -n 8 "$WORK/validation.log" | tr '\n' ' ')"
			rm -f "$WORK/$IMAGE"
			die "sysupgrade rejected image"
		}

	progress_set preparing "校验通过，正在保存额外软件包列表" "$SIZE"
	mkdir -p "$STATE"
	if [ -s "$WORK/extras" ]; then
		tmp="$STATE/packages.$"
		{ printf '%s\n' "$RESTORE_HEADER"; cat "$WORK/extras"; } >"$tmp" ||
			die "cannot save extra package list"
		mv -f "$tmp" "$STATE/packages" || die "cannot preserve extra package list"
	else
		rm -f "$STATE/packages"
	fi
	progress_set flashing "开始刷写固件，完成后设备将自动重启" "$SIZE"
	log "开始刷写固件：$LATEST"
	sysupgrade "$WORK/$IMAGE"
}

cmd_start() {
	mkdir -p "$WORK"
	# The UI may be opened in several tabs. Never launch duplicate upgrades.
	if ! mkdir "$WORK/ota-running" 2>/dev/null; then
		echo "OTA 更新任务已在运行，请勿重复启动" >&2
		return 1
	fi
	: >/tmp/ppe-update.log
	OTA_PROGRESS_ACTIVE=1 progress_set starting "正在启动 OTA 更新任务" || {
		rmdir "$WORK/ota-running"
		return 1
	}
	(
		trap 'rmdir "$WORK/ota-running" 2>/dev/null || true' EXIT
		OTA_PROGRESS_ACTIVE=1
		progress_set checking "正在检查更新信息和设备匹配"
		# Let die() exit an inner shell so the parent records the exit code.
		(cmd_update "" "$1" manual)
		result=$?
		if [ "$result" -ne 0 ]; then
			phase=$(jq -r '.stage // ""' "$WORK/progress.json" 2>/dev/null)
			[ "$phase" = failed ] ||
				progress_set failed "升级任务中止（退出码 $result）"
		fi
		echo "exit $result"
	) </dev/null >/tmp/ppe-update.log 2>&1 &
}

cmd_auto() {
	[ "$(uci -q get ppe-update.main.auto)" = 1 ] || return 0
	lookup ""
	newer || return 0
	delay=$(uci -q get ppe-update.main.delay || echo 1)
	valid_integer "$delay" || die "invalid automatic update delay"
	now=$(date +%s)
	[ "$now" -ge $((LATEST_TIME + delay * 86400)) ] || return 0
	# Scheduled and manual upgrades share one lock and one progress feed.
	# This also prevents the cron task racing an active LuCI upgrade.
	mkdir -p "$WORK"
	if ! mkdir "$WORK/ota-running" 2>/dev/null; then
		log "OTA 更新任务已在运行，跳过本次自动更新"
		return 0
	fi
	trap 'rmdir "$WORK/ota-running" 2>/dev/null || true' EXIT
	OTA_PROGRESS_ACTIVE=1
	progress_set starting "定时更新：正在准备升级"
	cmd_update "$LATEST" "" auto
}

# Restore only v2 explicitly selected packages. Old v1 lists are quarantined
# before any package manager/network action, without erasing user choices.
cmd_restore() {
	[ -s "$STATE/packages" ] || return 0
	lock -n /var/lock/ppe-update || return 0
	archive_legacy_queue || return 1
	[ -s "$STATE/packages" ] || return 0
	mkdir -p "$WORK"
	sed '1d' "$STATE/packages" >"$WORK/restore-list"
	if [ ! -s "$WORK/restore-list" ]; then
		rm -f "$STATE/packages"
		return 0
	fi

	# The network comes up after boot; retry for up to an hour.
	i=0
	until apk update >/dev/null 2>&1; do
		i=$((i + 1))
		[ "$i" -lt 120 ] || die "no package feed reachable; the list stays in $STATE/packages"
		sleep 30
	done
	# shellcheck disable=SC2046
	if apk add $(cat "$WORK/restore-list"); then
		log "reinstalled: $(tr '\n' ' ' <"$WORK/restore-list")"
		rm -f "$STATE/packages"
		return 0
	fi
	del=$(grep '^!' "$WORK/restore-list")
	printf '%s\n' "$RESTORE_HEADER" >"$WORK.left"
	grep -v '^!' "$WORK/restore-list" | while IFS= read -r p; do
		# shellcheck disable=SC2086
		apk add $del "$p" >/dev/null 2>&1 || apk add "$p" || echo "$p" >>"$WORK.left"
	done
	# shellcheck disable=SC2086
	[ -z "$del" ] || apk add $del || echo "$del" >>"$WORK.left"
	if [ "$(wc -l <"$WORK.left")" -gt 1 ]; then
		mv "$WORK.left" "$STATE/packages"
		die "not reinstalled: $(sed '1d' "$STATE/packages" | tr '\n' ' ')- the list stays in $STATE/packages"
	fi
	log "reinstalled: $(tr '\n' ' ' <"$WORK/restore-list")"
	rm -f "$STATE/packages" "$WORK.left"
}

# Tests source the functions without starting an update.
[ -n "$PPE_UPDATE_LIB" ] && return 0

case "$1" in
status | check | auto | restore | progress) "cmd_$1" ;;
update) cmd_update "" "$2" ;;
start) cmd_start "$2" ;;
*)
	echo "usage: ppe-update {status|check|update|start|auto|restore|progress}" >&2
	exit 2
	;;
esac
