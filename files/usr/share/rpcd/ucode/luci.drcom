#!/usr/bin/env ucode
'use strict';

/*
 * Dr.COM Web portal RPC backend.
 * Login/logout URL are independent fully configurable HTTP(S) URLs.
 * Stored passwords never leave get_config or appear in curl argv.
 */
import { cursor } from 'uci';
import { open, readfile, unlink, chmod, popen } from 'fs';

const SCRIPT = '/usr/libexec/drcom-web';
const SCHEDULE = '/usr/libexec/drcom-schedule';

function valid_url(url) {
	// ucode uses POSIX EREs: no (?:...) groups or JS \xNN escapes.
	// The portal URL may contain a host, port, path and query string.
	if (type(url) != 'string' || length(url) < 10 || length(url) > 512)
		return false;

	// Never accept whitespace, control characters or URL fragments.
	if (match(url, /[[:space:][:cntrl:]#]/))
		return false;

	return match(url, /^https?:\/\/[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?(\/[A-Za-z0-9._~%!$&()*+,;=:@/?-]*)?$/) != null;
}

function valid_secret(value, maximum) {
	return type(value) == 'string' &&
		length(value) > 0 && length(value) <= maximum &&
		!match(value, /[[:cntrl:]]/);
}

function config() {
	// Only explicit UCI values are returned; no hardcoded school host and no
	// legacy hostname fallback that could replace newly saved URL values.
	const uci = cursor();
	if (uci.load('drcom') != true)
		return null;
	const saved = {
		login_url: uci.get('drcom', 'main', 'login_url') || '',
		logout_url: uci.get('drcom', 'main', 'logout_url') || '',
		remember: uci.get('drcom', 'main', 'remember') == '1',
		auto: uci.get('drcom', 'main', 'auto') == '1',
		username: uci.get('drcom', 'main', 'username') || '',
		password: uci.get('drcom', 'main', 'password') || ''
	};
	uci.unload('drcom');
	return saved;
}

function save_changes(changes, forget_password) {
	const uci = cursor();
	if (uci.load('drcom') != true)
		return false;

	// Verify every change, not merely a successful commit return value.
	for (let key in keys(changes)) {
		if (uci.set('drcom', 'main', key, changes[key]) != true) {
			uci.unload('drcom');
			return false;
		}
	}
	if (forget_password) {
		uci.delete('drcom', 'main', 'username');
		uci.delete('drcom', 'main', 'password');
		if (uci.set('drcom', 'main', 'auto', '0') != true) {
			uci.unload('drcom');
			return false;
		}
	}
	const committed = uci.commit('drcom') == true;
	uci.unload('drcom');
	if (!committed)
		return false;

	// The router stores passwords in root-only UCI config, including on ext4/
	// F2FS overlay. Verify persistence using an independent cursor.
	if (chmod('/etc/config/drcom', 0o600) != true)
		return false;
	const verify = cursor();
	if (verify.load('drcom') != true)
		return false;
	let correct = true;
	for (let key in keys(changes)) {
		if ((verify.get('drcom', 'main', key) || '') != changes[key]) {
			correct = false;
			break;
		}
	}
	if (forget_password)
		correct = correct &&
			!verify.get('drcom', 'main', 'username') &&
			!verify.get('drcom', 'main', 'password') &&
			verify.get('drcom', 'main', 'auto') == '0';
	verify.unload('drcom');
	return correct;
}

function run(action, payload) {
	let filepath = null;
	if (payload != null) {
		// A random 0600 file in tmpfs holds the one-time login credentials.
		// No account names or passwords are passed through process argv.
		let uuid = readfile('/proc/sys/kernel/random/uuid');
		uuid = uuid ? trim(uuid) : '';
		if (!match(uuid, /^[0-9a-f-]{36}$/))
			return { ok: false, state: 'unknown', message: '无法创建安全的认证请求' };

		filepath = '/tmp/drcom-request-' + uuid + '.json';
		let file = open(filepath, 'wx', 0o600);
		if (!file)
			return { ok: false, state: 'unknown', message: '无法创建临时认证文件' };

		let written = file.write(sprintf('%J', payload));
		file.close();
		if (written == null || written <= 0) {
			unlink(filepath);
			return { ok: false, state: 'unknown', message: '认证请求写入失败' };
		}
	}

	let process = popen(SCRIPT + ' ' + action + (filepath ? ' ' + filepath : '') + ' 2>/dev/null', 'r');
	let raw = process ? process.read('all') : '';
	if (process)
		process.close();
	if (filepath)
		unlink(filepath);

	let result = null;
	try { result = raw ? json(raw) : null; } catch (e) {}
	if (!result || type(result) != 'object' || type(result.ok) != 'bool')
		return { ok: false, state: 'unknown', message: '认证服务未返回有效结果' };
	return result;
}

const methods = {
	get_config: {
		call: function() {
			const s = config();
			if (!s)
				return { error: '无法读取校园网 UCI 配置', login_url: '', logout_url: '',
					remember: false, auto: false, username: '', has_password: false };
			return {
				backend_revision: 'drcom-rpc12',
				login_url: s.login_url,
				logout_url: s.logout_url,
				remember: s.remember,
				auto: s.auto,
				username: s.remember ? s.username : '',
				has_password: s.remember && !!s.password
			};
		}
	},
	get_status: {
		call: function() {
			const s = config();
			if (!s || !valid_url(s.login_url))
				return { ok: false, state: 'unknown', message: '请先填写并保存认证地址' };
			return run('status', null);
		}
	},
	save_urls: {
		args: { login_url: '', logout_url: '' },
		call: function(request) {
			// Report the failing stage without exposing URLs or credentials.
			let stage = 'request';
			try {
				const a = request?.args || {};
				stage = 'validate_url';
				if (!valid_url(a.login_url) || !valid_url(a.logout_url))
					return { ok: false, code: 'invalid_url', message: '认证地址格式不正确，请填写完整 HTTP(S) URL' };

				stage = 'uci_cursor';
				const cur = cursor();
				if (!cur)
					return { ok: false, code: 'uci_cursor', message: '无法打开校园网配置' };

				stage = 'uci_load';
				if (cur.load('drcom') != true)
					return { ok: false, code: 'uci_load', message: '无法加载 /etc/config/drcom' };

				stage = 'uci_set';
				if (cur.set('drcom', 'main', 'login_url', a.login_url) != true ||
					cur.set('drcom', 'main', 'logout_url', a.logout_url) != true) {
					cur.unload('drcom');
					return { ok: false, code: 'uci_set', message: '无法写入认证地址，请检查 drcom.main 配置' };
				}

				stage = 'uci_commit';
				const committed = cur.commit('drcom') == true;
				cur.unload('drcom');
				if (!committed)
					return { ok: false, code: 'uci_commit', message: '配置提交失败，请检查 /overlay 是否可写' };

				stage = 'file_permissions';
				if (chmod('/etc/config/drcom', 0o600) != true)
					return { ok: false, code: 'chmod', message: '配置已保存，但无法设置文件权限' };

				stage = 'uci_verify';
				const verify = cursor();
				if (!verify || verify.load('drcom') != true)
					return { ok: false, code: 'uci_reload', message: '配置已提交，但重新加载失败' };

				stage = 'readback';
				const login_url = verify.get('drcom', 'main', 'login_url') || '';
				const logout_url = verify.get('drcom', 'main', 'logout_url') || '';
				verify.unload('drcom');

				if (login_url != a.login_url || logout_url != a.logout_url)
					return { ok: false, code: 'uci_mismatch', message: '保存后读回的地址不一致，请检查配置持久化' };

				return {
					ok: true, backend_revision: 'drcom-rpc12',
					login_url, logout_url,
					message: '认证地址已保存'
				};
			} catch (e) {
				return {
					ok: false, code: 'backend_exception_' + stage,
					message: '认证地址保存异常，阶段：' + stage
				};
			}
		}
	},

	// Save the entire credential card without requiring an authentication request.
	// A blank password retains the previous secret only for the same username.
	save_credentials: {
		args: { login_url: '', logout_url: '', username: '', password: '' },
		call: function(request) {
			let stage = 'validate';
			try {
				const a = request?.args || {};
				if (!valid_url(a.login_url) || !valid_url(a.logout_url))
					return { ok: false, code: 'invalid_url', message: '认证地址格式不正确' };

				const username = a.username || '';
				if (!valid_secret(username, 128))
					return { ok: false, code: 'invalid_username', message: '请输入有效的用户名' };

				stage = 'read_existing';
				const saved = config();
				if (!saved)
					return { ok: false, code: 'uci_load', message: '读取现有认证配置失败' };

				const password = a.password || (
					saved.remember && saved.username == username ? saved.password : ''
				);
				if (!valid_secret(password, 256))
					return { ok: false, code: 'invalid_password', message: '请输入密码；修改用户名时也需要填写密码' };

				stage = 'uci_save';
				if (!save_changes({
					login_url: a.login_url,
					logout_url: a.logout_url,
					username: username,
					password: password,
					remember: '1'
				}, false))
					return { ok: false, code: 'uci_save', message: '保存账号信息失败，请检查 UCI 配置和存储空间' };

				stage = 'readback';
				const verified = config();
				if (!verified ||
					verified.login_url != a.login_url ||
					verified.logout_url != a.logout_url ||
					verified.username != username ||
					verified.password != password ||
					!verified.remember)
					return { ok: false, code: 'uci_mismatch', message: '认证信息保存后校验失败' };

				// Never include the password in a ubus reply, including on success.
				return {
					ok: true, backend_revision: 'drcom-rpc12',
					login_url: verified.login_url,
					logout_url: verified.logout_url,
					username: verified.username,
					has_password: true,
					message: '认证信息已保存'
				};
			} catch (e) {
				return {
					ok: false, code: 'backend_exception_' + stage,
					message: '认证信息保存异常，阶段：' + stage
				};
			}
		}
	},
	login: {
		args: { username: '', password: '', remember: true, login_url: '', logout_url: '' },
		call: function(request) {
			let a = request.args || {};
			let saved = config();
			if (!saved)
				return { ok: false, state: 'unknown', message: '读取校园网配置失败' };
			let url = a.login_url || '';
			let logout_url = a.logout_url || '';

			if (!valid_url(url) || !valid_url(logout_url))
				return { ok: false, state: 'unknown', message: '请填写有效的 HTTP(S) 登录与注销地址' };

			let username = a.username || '';
			let password = a.password || '';
			if (!password && saved.remember && username == saved.username)
				password = saved.password;

			if (!valid_secret(username, 128) || !valid_secret(password, 256))
				return { ok: false, state: 'unknown', message: '账号或密码格式有误' };

			let remember = a.remember === true;
			if (!save_changes({
				login_url: url,
				logout_url: logout_url,
				remember: remember ? '1' : '0',
				username: remember ? username : '',
				password: remember ? password : ''
			}, !remember))
				return { ok: false, state: 'unknown', message: '保存校园网配置失败' };

			const result = run('login', { username, password });
			result.saved = true;
			return result;
		}
	},
	set_auto: {
		args: { enabled: false },
		call: function(request) {
			let enabled = request.args?.enabled === true;
			let saved = config();
			if (!saved)
				return { ok: false, auto: false, message: '无法读取校园网配置' };
			if (enabled && (!saved.remember || !saved.username || !saved.password))
				return { ok: false, auto: false, message: '先勾选“记住账号密码”并登录一次，才能开启每天 00:00 自动认证' };
			if (enabled && (!valid_url(saved.login_url) || !valid_url(saved.logout_url)))
				return { ok: false, auto: false, message: '认证地址无效，请先保存正确的地址' };

			// Every boot installs exactly one cron line. Also repair it when
			// changing settings so a lost crontab never silently disables auto.
			if (system(SCHEDULE + ' sync >/dev/null 2>&1') != 0)
				return { ok: false, auto: saved.auto, message: '无法安装定时任务，请检查 cron 服务' };

			if (!save_changes({ auto: enabled ? '1' : '0' }, false))
				return { ok: false, auto: saved.auto, message: '保存自动认证开关失败' };
			return {
				ok: true, auto: enabled,
				message: enabled ? '每天 00:00 自动认证已开启' : '已关闭每日自动认证'
			};
		}
	},
	logout: {
		call: function() {
			const s = config();
			if (!s || !valid_url(s.logout_url))
				return { ok: false, state: 'unknown', message: '请先填写并保存注销地址' };
			return run('logout', null);
		}
	},
	forget: {
		call: function() {
			if (!save_changes({ remember: '0' }, true))
				return { ok: false, message: '清除已保存凭据失败' };
			return { ok: true, message: '账号密码已清除，自动认证已关闭' };
		}
	}
};

return { 'luci.drcom': methods };
