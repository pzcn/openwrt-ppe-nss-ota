#!/bin/sh
# Dr.COM Web portal transport. One-time secrets are read from a private
# /tmp file. Saved auto-login secrets come from root-only UCI config.
# curl reads all POST data via stdin (-K -), never from command arguments.
set -eu
umask 077

ACTION="${1:-}"
REQUEST="${2:-}"
BODY="$(mktemp /tmp/drcom-response.XXXXXX)" || exit 1
trap 'rm -f "$BODY"; [ -z "$REQUEST" ] || rm -f "$REQUEST"' EXIT
trap 'exit 1' HUP INT TERM

emit() {
	printf '{"ok":%s,"state":"%s","message":"%s"}\n' "$1" "$2" "$3"
}
fail() {
	emit false unknown "$1"
	exit 0
}

# Full HTTP(S) URLs are editable; reject userinfo, fragments, controls and
# shell/config punctuation. Both DNS and numeric IP hosts are accepted.
valid_url() {
	[ -n "$1" ] && [ "${#1}" -le 512 ] &&
		printf '%s' "$1" |
		LC_ALL=C grep -Eq '^https?://[[:alnum:]][[:alnum:].-]*(:[0-9]{1,5})?(/[[:alnum:]_~.%!$&()*+,;=:@/?-]*)?$'
}

config_get() {
	uci -q get "drcom.main.$1" 2>/dev/null || true
}

base="$(config_get server)"
[ -n "$base" ] || base='http://gate.lnu.edu.cn'
case "$base" in */) base="${base%/}" ;; esac

login_url="$(config_get login_url)"
[ -n "$login_url" ] || login_url="$base/0.htm"
logout_url="$(config_get logout_url)"
if [ -z "$logout_url" ]; then
	logout_path="$(config_get logout_path)"
	[ -n "$logout_path" ] || logout_path='/F.htm'
	logout_url="$base$logout_path"
fi

valid_url "$login_url" || fail '登录地址格式不正确（需完整的 HTTP/HTTPS URL）'
valid_url "$logout_url" || fail '注销地址格式不正确（需完整的 HTTP/HTTPS URL）'

# Escape quotes and backslashes for curl's config file syntax.
curlquote() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# HTTP 200 only means the server replied, not that authentication succeeded.
classify() {
	case "$1" in
		login)
			if grep -Eq 'Dr\.COMWebLoginID_3\.htm|登录成功|认证成功|成功登录|login[[:space:]]+success' "$BODY"; then
				emit true online '门户返回认证成功页面'
			elif grep -Eq 'Dr\.COMWebLoginID_2\.htm|认证失败|登录失败|密码错误|账号或密码' "$BODY"; then
				emit false offline '门户返回认证失败信息，请检查账号或密码'
			else
				emit true unknown '登录请求已发送，门户未返回可识别的成功标记'
			fi
			;;
		logout)
			if grep -Eq 'Dr\.COMWebLoginID_0\.htm|注销成功|退出成功|成功退出|Logout[[:space:]]+success' "$BODY"; then
				emit true offline '门户返回注销成功页面'
			else
				emit true unknown '已发送注销请求，但未确认下线结果'
			fi
			;;
		status)
			if grep -q 'Dr.COMWebLoginID_1.htm' "$BODY"; then
				emit true online '门户显示已认证在线'
			elif grep -Eq 'Dr\.COMWebLoginID_0\.htm|Dr\.COMWebLoginID_2\.htm' "$BODY"; then
				emit true offline '门户显示尚未认证'
			else
				emit true unknown '门户可以访问，但没有可识别的在线标记'
			fi
			;;
	esac
}

case "$ACTION" in
	status)
		# Try the root of the selected login URL as a non-credential status
		# page; not all Dr.COM variants expose a usable status page.
		status_url="$(printf '%s' "$login_url" | sed -E 's@^(https?://[^/]+).*@\1/@')"
		if code="$(curl -sS --noproxy '*' --proto '=http,https' \
			--connect-timeout 4 --max-time 9 \
			-o "$BODY" -w '%{http_code}' "$status_url" 2>/dev/null)"; then
			case "$code" in 2??) classify status ;; *) fail '认证门户状态查询返回非 2xx HTTP 状态' ;; esac
		else
			fail '无法连接校园网认证门户'
		fi
		;;
	login | auto)
		if [ "$ACTION" = 'auto' ]; then
			# The cron line may always exist. Login only when explicitly
			# enabled and a remembered account/password is available.
			[ "$(config_get auto)" = '1' ] &&
			[ "$(config_get remember)" = '1' ] || {
				emit true unknown '自动认证已关闭或未保存凭据'
				exit 0
			}
			username="$(config_get username)"
			password="$(config_get password)"
		else
			[ -n "$REQUEST" ] && [ -f "$REQUEST" ] && [ ! -L "$REQUEST" ] ||
				fail '缺少临时认证凭据'
			[ "$(stat -c '%a' "$REQUEST" 2>/dev/null)" = 600 ] ||
				fail '临时凭据权限不安全'
			username="$(jsonfilter -i "$REQUEST" -e '@.username' 2>/dev/null || true)"
			password="$(jsonfilter -i "$REQUEST" -e '@.password' 2>/dev/null || true)"
			rm -f "$REQUEST"
			REQUEST=''
		fi

		[ -n "$username" ] && [ -n "$password" ] || fail '请先保存有效的账号和密码'
		if printf '%s' "$username$password" | LC_ALL=C grep -q '[[:cntrl:]]'; then
			fail '账号或密码不允许包含控制字符'
		fi

		if code="$(
			{
				printf 'url = "%s"\n' "$login_url"
				printf 'data-urlencode = "DDDDD=%s"\n' "$(curlquote "$username")"
				printf 'data-urlencode = "upass=%s"\n' "$(curlquote "$password")"
				printf 'data = "0MKKey="\n'
			} | curl -sS --noproxy '*' --proto '=http,https' \
				--connect-timeout 4 --max-time 12 \
				-o "$BODY" -w '%{http_code}' -K - 2>/dev/null
		)"; then
			case "$code" in
				2??|3??) classify login ;;
				*) fail '认证门户拒绝请求，请检查地址和参数' ;;
			esac
		else
			fail '认证请求失败，请检查上联网关或登录地址'
		fi
		;;
	logout)
		if code="$(curl -sS --noproxy '*' --proto '=http,https' \
			--connect-timeout 4 --max-time 9 \
			-o "$BODY" -w '%{http_code}' "$logout_url" 2>/dev/null)"; then
			case "$code" in 2??|3??) classify logout ;; *) fail '校园网门户拒绝注销请求' ;; esac
		else
			fail '无法连接校园网注销地址'
		fi
		;;
	*)
		fail '不支持的认证操作'
		;;
esac
