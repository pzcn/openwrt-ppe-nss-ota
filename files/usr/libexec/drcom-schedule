#!/bin/sh
# Maintain exactly one midnight cron entry without deleting unrelated jobs.
# The job itself checks drcom.main.auto and drcom.main.remember each run.
set -eu
umask 077

CRONTAB="${DRCOM_CRONTAB:-/etc/crontabs/root}"
ENTRY='0 0 * * * /usr/libexec/drcom-web auto >/dev/null 2>&1 # drcom-campus-auto'

case "${1:-}" in
	sync) ;;
	*) echo "usage: drcom-schedule sync" >&2; exit 2 ;;
esac

mkdir -p "$(dirname "$CRONTAB")"
TMP="$(mktemp "${CRONTAB}.tmp.XXXXXX")" || exit 1
trap 'rm -f "$TMP"' EXIT
trap 'exit 1' HUP INT TERM

if [ -f "$CRONTAB" ]; then
	awk 'index($0, "# drcom-campus-auto") == 0 { print }' "$CRONTAB" > "$TMP"
else
	: > "$TMP"
fi

printf '%s\n' "$ENTRY" >> "$TMP"
chmod 0600 "$TMP"
mv -f "$TMP" "$CRONTAB"

# This can be skipped in offline tests; real router always reloads cron.
if [ "${DRCOM_SKIP_CRON_RELOAD:-0}" != 1 ] && [ -x /etc/init.d/cron ]; then
	/etc/init.d/cron reload >/dev/null 2>&1 ||
		/etc/init.d/cron restart >/dev/null 2>&1 || true
fi
