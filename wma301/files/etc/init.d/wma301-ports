#!/bin/sh /etc/rc.common
# WMA301 v2 DHCP WAN/LAN auto detection.
START=92
STOP=12
USE_PROCD=1

start_service() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		tplink,wma301-v2|tplink,wma301-v2-1) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/wma301-ports daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
