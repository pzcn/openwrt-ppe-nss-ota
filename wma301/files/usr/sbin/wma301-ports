#!/bin/sh
# WMA301 v2: DSA WAN/LAN blind plugging, with a manual override.
set -u

TAG=wma301-ports
PORTS="lan1 lan2 lan3 wan"
STATE_DIR=/tmp/wma301-ports
LOCK_DIR="$STATE_DIR/scan.lock"
PROBE_SCRIPT=/usr/libexec/wma301-ports-dhcp-probe
SYS_NET=/sys/class/net
BOARD_FILE=/tmp/sysinfo/board_name

log() { logger -t "$TAG" "$*" 2>/dev/null || true; }
board_supported() {
    case "$(cat "$BOARD_FILE" 2>/dev/null || true)" in
        tplink,wma301-v2|tplink,wma301-v2-1) return 0 ;;
        *) return 1 ;;
    esac
}
die() { echo "$TAG: $*" >&2; exit 1; }
is_port() { case "$1" in lan1|lan2|lan3|wan) return 0 ;; *) return 1 ;; esac; }
port_for_choice() {
    case "$1" in
        1) echo lan1 ;; 2) echo lan2 ;; 3) echo lan3 ;; 4) echo wan ;;
        *) return 1 ;;
    esac
}
choice_for_port() {
    case "$1" in
        lan1) echo 1 ;; lan2) echo 2 ;; lan3) echo 3 ;; wan) echo 4 ;;
        *) echo 0 ;;
    esac
}
mode() {
    local m
    m="$(uci -q get wma301-ports.main.mode 2>/dev/null || true)"
    case "$m" in auto|1|2|3|4) echo "$m" ;; *) echo auto ;; esac
}
active() {
    local p
    p="$(uci -q get wma301-ports.main.active 2>/dev/null || true)"
    is_port "$p" && echo "$p" || echo none
}
set_active() {
    [ "$(active)" = "$1" ] && return 0
    uci -q set "wma301-ports.main.active=$1" || return 1
    uci -q commit wma301-ports
}
exists() { [ -d "$SYS_NET/$1" ]; }
carrier() { [ "$(cat "$SYS_NET/$1/carrier" 2>/dev/null || echo 0)" = 1 ]; }
signature() {
    local p v
    for p in $PORTS; do
        v="$(cat "$SYS_NET/$p/carrier" 2>/dev/null || echo 0)"
        printf '%s=%s;' "$p" "$v"
    done
    echo
}
bridge_section() {
    local section
    for section in $(uci -q show network 2>/dev/null | sed -n 's/^network\.\([^=]*\)=device$/\1/p'); do
        [ "$(uci -q get "network.$section.name" 2>/dev/null || true)" = br-lan ] || continue
        echo "$section"
        return 0
    done
    return 1
}
# Always restore the kernel bridge to match committed UCI after an interruption.
restore_kernel_bridge() {
    local section ports p
    section="$(bridge_section || true)"
    [ -n "$section" ] || return 0
    ports="$(uci -q get "network.$section.ports" 2>/dev/null || true)"
    for p in $PORTS; do
        exists "$p" || continue
        case " $ports " in
            *" $p "*) ip link set dev "$p" master br-lan 2>/dev/null || true ;;
            *) ip link set dev "$p" nomaster 2>/dev/null || true ;;
        esac
    done
}
apply_port() {
    local target="$1" bridge old_ports new_ports p old_wan old_wan6 changed
    [ "$target" = none ] || is_port "$target" || return 1
    bridge="$(bridge_section)" || { log "br-lan config missing"; return 1; }
    old_ports="$(uci -q get "network.$bridge.ports" 2>/dev/null || true)"
    old_wan="$(uci -q get network.wan.device 2>/dev/null || true)"
    old_wan6="$(uci -q get network.wan6.device 2>/dev/null || true)"
    new_ports=""
    # Preserve non-WMA bridge members and make all other physical ports LAN.
    for p in $old_ports; do
        if ! is_port "$p"; then
            new_ports="${new_ports:+$new_ports }$p"
        fi
    done
    for p in $PORTS; do
        [ "$p" = "$target" ] && continue
        new_ports="${new_ports:+$new_ports }$p"
    done
    changed=0
    if [ "$new_ports" != "$old_ports" ] || [ "$old_wan" != "$target" ]; then
        changed=1
        uci -q delete "network.$bridge.ports" 2>/dev/null || true
        for p in $new_ports; do
            uci -q add_list "network.$bridge.ports=$p" || return 1
        done
        if [ "$target" = none ]; then
            uci -q delete network.wan.device 2>/dev/null || true
        else
            uci -q set "network.wan.device=$target" || return 1
        fi
        # Preserve wan6.device=@wan aliases. Only move explicit DSA bindings.
        if is_port "$old_wan6"; then
            if [ "$target" = none ]; then
                uci -q delete network.wan6.device 2>/dev/null || true
            else
                uci -q set "network.wan6.device=$target" || return 1
            fi
        fi
        uci -q commit network || return 1
    fi
    set_active "$target" || return 1
    if [ "$changed" -eq 1 ]; then
        log "WAN=$target; br-lan=$new_ports"
        ubus call network reload >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1 || true
        ifdown wan >/dev/null 2>&1 || true
        ifdown wan6 >/dev/null 2>&1 || true
        if [ "$target" != none ]; then
            ifup wan >/dev/null 2>&1 || true
            ifup wan6 >/dev/null 2>&1 || true
        fi
        sleep 1
    fi
    restore_kernel_bridge
}
probe_dhcp() {
    local p="$1" result="$STATE_DIR/offer" pidfile="$STATE_DIR/udhcpc.pid"
    rm -f "$result" "$pidfile"
    WMA301_DHCP_RESULT="$result" udhcpc -f -n -q -t 2 -T 2 \
        -i "$p" -s "$PROBE_SCRIPT" -p "$pidfile" \
        >"$STATE_DIR/probe.log" 2>&1 || true
    rm -f "$pidfile"
    [ -s "$result" ]
}
scan() {
    local p found=none
    mkdir -p "$STATE_DIR"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        log "another scan in progress"
        return 0
    fi
    # Never leave ports detached when a mode change terminates the daemon.
    trap 'restore_kernel_bridge; rmdir "$LOCK_DIR" 2>/dev/null || true; exit 0' HUP INT TERM
    log "starting isolated DHCP uplink discovery"
    # Probe one port at a time, isolated from br-lan.  Keep every
    # *other* LAN port up throughout the scan; a full-bridge teardown
    # would disconnect all clients whenever an uplink is plugged in.
    for p in $PORTS; do
        exists "$p" && carrier "$p" || continue
        ip link set dev "$p" nomaster 2>/dev/null || true
        ip link set dev "$p" up 2>/dev/null || true
        sleep 1
        if probe_dhcp "$p"; then
            found="$p"
            log "DHCP uplink detected on $p"
            break
        fi
        restore_kernel_bridge
    done
    if ! apply_port "$found"; then
        log "cannot apply scanned WAN=$found"
        restore_kernel_bridge
    fi
    rmdir "$LOCK_DIR" 2>/dev/null || true
    trap - HUP INT TERM
}
daemon() {
    local m a sig previous= first=1 requested
    board_supported || exit 0
    sleep 4  # netifd must create br-lan before reassignment
    while :; do
        m="$(mode)"
        a="$(active)"
        if [ "$m" = auto ]; then
            sig="$(signature)"
            if is_port "$a" && carrier "$a"; then
                # Sticky WAN: no changes on ping loss, DHCP renewal or LAN plug.
                previous="$sig"
            elif [ "$first" = 1 ] || [ "$sig" != "$previous" ] || [ "$a" != none ]; then
                sleep 2  # carrier debounce
                a="$(active)"
                if ! is_port "$a" || ! carrier "$a"; then
                    scan
                fi
                previous="$(signature)"
            fi
        else
            requested="$(port_for_choice "$m")"
            if [ "$a" != "$requested" ]; then
                apply_port "$requested" || log "manual WAN apply failed"
            fi
        fi
        first=0
        sleep 2
    done
}
status() {
    local m a n
    m="$(mode)"
    a="$(active)"
    n="$(choice_for_port "$a")"
    printf '{"mode":"%s","active":"%s","active_number":%s}\n' "$m" "$a" "$n"
}
set_mode() {
    local choice="$1"
    case "$choice" in auto|1|2|3|4) ;; *) die "invalid WAN choice" ;; esac
    board_supported || die "wrong board"
    uci -q set "wma301-ports.main.mode=$choice" || die "cannot set mode"
    if [ "$choice" = auto ]; then
        # Switching back from manual must rediscover the upstream once.
        uci -q set wma301-ports.main.active=none || die "cannot reset WAN"
    fi
    uci -q commit wma301-ports || die "cannot save WAN choice"
    /etc/init.d/wma301-ports restart >/dev/null 2>&1 || die "cannot start detector"
    echo OK
}
case "${1:-}" in
    status) status ;;
    set) [ "$#" -eq 2 ] || die "usage: set auto|1|2|3|4"; set_mode "$2" ;;
    daemon) daemon ;;
    *) die "usage: $0 status|set|daemon" ;;
esac
