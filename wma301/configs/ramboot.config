# WMA301 v2.0/v2.1 RAM recovery (same universal device-tree GPIO layout).
# Full-source only, not the official ImageBuilder/sysupgrade pipeline.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tplink_wma301-v2=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tplink_wma301-v2=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
